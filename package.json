{
  "name": "p5comp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "start": "npm run build && node server/index.js",
    "test": "node --test",
    "mcp": "node server/mcp.js",
    "verify:examples": "node scripts/verify-examples.mjs",
    "vendor:ams": "sh -c 'cd \"${AMS_DIR:-$HOME/dev/artistmodelstudio}\" && if [ -n \"$AMS_FULL\" ]; then npm run build:embed:full && scripts/sync-embed.sh \"$OLDPWD/public/vendor/ams-editor\" full; else npm run build:embed && scripts/sync-embed.sh \"$OLDPWD/public/vendor/ams-editor\"; fi'"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.36.5",
    "@gohai/p5.webserial": "^1.1.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@wasm-fmt/clang-format": "^23.1.1",
    "@wokwi/elements": "^1.9.2",
    "ajv": "^8.20.0",
    "avr8js": "^0.21.1",
    "avrgirl-arduino": "^5.0.1",
    "codemirror": "^6.0.1",
    "dompurify": "^3.4.17",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "katex": "^0.19.0",
    "lit": "^3.3.3",
    "marked": "^18.1.1",
    "p5": "2.3.4",
    "p5-v1": "npm:p5@1.11.10",
    "prettier": "^3.9.10"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "concurrently": "^9.1.2",
    "vite": "^6.2.6"
  }
}
