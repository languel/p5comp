  "arduino": "// Double-click a sensor to simulate illumination or motion.\n// LDR: more light -> lower analog value. PIR holds OUT HIGH for 2 seconds.\nvoid setup() {\n  Serial.begin(9600);\n  pinMode(2, INPUT); pinMode(3, INPUT);\n  pinMode(LED_BUILTIN, OUTPUT);\n}\nvoid loop() {\n  int light = analogRead(A0);\n  bool dark = digitalRead(2);\n  bool motion = digitalRead(3);\n  digitalWrite(LED_BUILTIN, motion && dark);\n  Serial.print(light); Serial.print(',');\n  Serial.print(dark); Serial.print(','); Serial.println(motion);\n  delay(60);\n}\n",
  "artifact": {
