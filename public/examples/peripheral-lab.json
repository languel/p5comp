    "buildKey": "void nibble(byte value) {\n  for(byte i=0;i<4;i++) digitalWrite(4+i, (value>>i)&1);\n  digitalWrite(3,HIGH); delayMicroseconds(2); digitalWrite(3,LOW); delayMicroseconds(50);\n}\nvoid lcd(byte value, bool data=false) {digitalWrite(2,data);nibble(value>>4);nibble(value&15);}\nvoid setup() {\n for(byte p=2;p<=13;p++) pinMode(p,OUTPUT);\n pinMode(A0,OUTPUT);\n delay(40); nibble(3);delay(5);nibble(3);nibble(3);nibble(2);lcd(0x28);lcd(0x0c);lcd(1);delay(2);lcd(0x80);\n const char *message=\"p5comp: hello!\";while(*message)lcd(*message++,true);\n digitalWrite(9,HIGH);digitalWrite(10,LOW);digitalWrite(11,HIGH);digitalWrite(12,HIGH);digitalWrite(13,HIGH);\n Serial.begin(9600);Serial.println(\"Nano + RGB + LCD + servo\");\n tone(A0,440);\n}\nvoid loop() {digitalWrite(8,HIGH);delayMicroseconds(1472);digitalWrite(8,LOW);delay(19);}\n{}nano",
