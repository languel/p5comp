  "arduino": "// Adafruit NeoPixel library (Arduino Library Manager).\n// Data flows through 8 ring LEDs, 8 strip LEDs, then the single pixel.\n#include <Adafruit_NeoPixel.h>\nconst int DATA_PIN = 6;\nconst int PIXEL_COUNT = 17;\nAdafruit_NeoPixel pixels(PIXEL_COUNT, DATA_PIN, NEO_GRB + NEO_KHZ800);\n\nvoid setup() {\n  pixels.begin();\n  pixels.clear();\n  pixels.show();\n}\n\nvoid loop() {\n  static int frame = 0;\n  pixels.clear();\n  for (int i = 0; i < PIXEL_COUNT; i++) {\n    int color = (i + frame) % 3;\n    pixels.setPixelColor(i, color == 0 ? 80 : 0,\n                           color == 1 ? 80 : 0,\n                           color == 2 ? 80 : 0);\n  }\n  pixels.show();\n  frame++;\n  delay(250);\n}\n",
  "artifact": {
