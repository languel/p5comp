  "arduino": "// Drive one row LOW, release other rows, and read pulled-up columns.\n// Real matrix contacts: simultaneous keys can produce ghosting (no diodes).\nconst char keys[4][4] = {\n  {'1','2','3','A'}, {'4','5','6','B'},\n  {'7','8','9','C'}, {'*','0','#','D'}\n};\nvoid setup() {\n  Serial.begin(9600);\n  pinMode(LED_BUILTIN, OUTPUT);\n  for (int col = 0; col < 4; col++) pinMode(6 + col, INPUT_PULLUP);\n}\nvoid loop() {\n  bool pressed = false;\n  for (int row = 0; row < 4; row++) {\n    pinMode(2 + row, OUTPUT);\n    digitalWrite(2 + row, LOW);\n    delayMicroseconds(10);\n    for (int col = 0; col < 4; col++) {\n      if (digitalRead(6 + col) == LOW) { Serial.println(keys[row][col]); pressed = true; }\n    }\n    pinMode(2 + row, INPUT);\n  }\n  digitalWrite(LED_BUILTIN, pressed);\n  delay(80);\n}\n",
