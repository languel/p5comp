  "arduino": "// Each closed DIP switch connects its input to GND. No external resistors:\n// INPUT_PULLUP keeps an open contact HIGH. Serial prints the eight bits.\nvoid setup() {\n  Serial.begin(9600);\n  pinMode(LED_BUILTIN, OUTPUT);\n  for (int pin = 2; pin <= 9; pin++) pinMode(pin, INPUT_PULLUP);\n}\nvoid loop() {\n  bool anyClosed = false;\n  for (int pin = 2; pin <= 9; pin++) {\n    bool closed = digitalRead(pin) == LOW;\n    Serial.print(closed ? '1' : '0');\n    anyClosed |= closed;\n  }\n  digitalWrite(LED_BUILTIN, anyClosed);\n  Serial.println();\n  delay(150);\n}\n",
  "artifact": {
